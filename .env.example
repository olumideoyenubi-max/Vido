# Vido shows every model whose backend is configured below.
# With nothing configured you get the offline "Mock preview" model.

PORT=3000
# Where job history and saved videos live (default: ./data)
# DATA_DIR=./data

# --- fal.ai: Wan 2.2 A14B (text/image to video, LoRAs) ---
# https://fal.ai/dashboard/keys
FAL_KEY=

# --- Replicate: Wan 2.2 Fast ---
# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# --- Your own GPU: Wan 2.2 TI2V 5B and LTX-2 via worker/ ---
# LOCAL_WORKER_URL=http://127.0.0.1:8188
# Must match WORKER_TOKEN on the worker if you set one.
# LOCAL_WORKER_TOKEN=

# Show the mock model alongside real ones (true/false)
# ENABLE_MOCK=false
