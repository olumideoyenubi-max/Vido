# Which backend generates videos: mock | replicate | fal
# "mock" needs no API key and is handy for trying the UI.
VIDEO_PROVIDER=mock

PORT=3000

# --- Replicate (https://replicate.com) ---
REPLICATE_API_TOKEN=
# Any Replicate video model that takes a `prompt` input.
REPLICATE_MODEL=minimax/video-01

# --- fal.ai (https://fal.ai) ---
FAL_KEY=
FAL_MODEL=fal-ai/kling-video/v2.1/standard/text-to-video
# Used instead of FAL_MODEL when a start image is supplied.
FAL_IMAGE_MODEL=fal-ai/kling-video/v2.1/standard/image-to-video
